{
  "name": "@zerynex/sdk",
  "version": "0.2.0",
  "description": "Local-first Zcash developer toolkit: PCZT policy checks, offline Rust/WASM, refund privacy regressions and wallet integration interfaces",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./wasm/zerynex_bg.wasm": "./dist/wasm/zerynex_bg.wasm"
  },
  "bin": {
    "zerynex-refund-check": "./bin/refund-check.mjs"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Oluwa-Laughter/zerynex",
    "directory": "packages/sdk"
  },
  "homepage": "https://zerynex.vercel.app/docs",
  "bugs": {
    "url": "https://github.com/Oluwa-Laughter/zerynex/issues"
  },
  "keywords": [
    "zcash",
    "pczt",
    "privacy",
    "webassembly",
    "blockchain",
    "wallet",
    "devtools"
  ],
  "publishConfig": {
    "access": "public"
  }
}
